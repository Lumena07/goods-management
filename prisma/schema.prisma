generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(ADMIN)
  isApproved   Boolean  @default(false)
  tempPassword Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdExpenses Expense[] @relation("createdExpenses")
  approvedExpenses Expense[] @relation("approvedExpenses")
}

model Customer {
  id            String        @id @default(cuid())
  name          String
  email         String?       @unique
  phone         String
  address       String?
  isAccredited  Boolean       @default(false)
  creditLimit   Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vatPreference VatPreference @default(VAT_INCLUSIVE)
  customPrices  CustomPrice[]
  sales         Sale[]
}

model CustomPrice {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Sale {
  id            String     @id @default(cuid())
  customerId    String?
  total         Float
  basePrice     Float
  vatAmount     Float
  isPaid        Boolean    @default(false)
  isAccredited  Boolean    @default(false)
  invoiceNumber String?
  dueDate       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  payments      Payment[]
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]

  @@index([customerId])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  email         String?
  phone         String
  address       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  vatPreference VatPreference   @default(VAT_INCLUSIVE)
  purchases     Purchase[]
  prices        SupplierPrice[]
}

model SupplierPrice {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model Purchase {
  id         String         @id @default(cuid())
  supplierId String
  total      Float
  basePrice  Float
  vatAmount  Float
  isPaid     Boolean        @default(false)
  status     PurchaseStatus @default(PENDING)
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]

  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  received   Int      @default(0)
  price      Float
  basePrice  Float
  vatAmount  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  basePrice      Float
  currentStock   Int             @default(0)
  minStock       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  priceType      VatPreference   @default(VAT_INCLUSIVE)
  customPrices   CustomPrice[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  supplierPrices SupplierPrice[]
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Float
  basePrice Float
  vatAmount Float
  discount  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id         String        @id @default(cuid())
  saleId     String
  amount     Float
  method     PaymentMethod
  reference  String?
  notes      String?
  recordedBy String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  sale       Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

enum Role {
  ADMIN
  SALES_CLERK
}

enum VatPreference {
  VAT_INCLUSIVE
  VAT_EXCLUSIVE
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  SALARY
  ELECTRICITY
  RENT
  TRANSPORT
  OTHER
}

model Expense {
  id          String         @id @default(cuid())
  amount      Float
  category    ExpenseCategory
  description String
  status      ExpenseStatus  @default(PENDING)
  createdBy   String
  approvedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User          @relation("createdExpenses", fields: [createdBy], references: [id])
  approver    User?         @relation("approvedExpenses", fields: [approvedBy], references: [id])

  @@index([createdBy])
  @@index([approvedBy])
}
