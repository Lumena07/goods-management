// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_CLERK
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(ADMIN)
  isApproved   Boolean  @default(false)
  tempPassword Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  phone        String
  address      String?
  isAccredited Boolean       @default(false)
  creditLimit  Float?
  sales        Sale[]
  customPrices CustomPrice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model CustomPrice {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  price      Float
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
}

model Sale {
  id            String     @id @default(cuid())
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  total         Float
  isPaid        Boolean    @default(false)
  isAccredited  Boolean    @default(false)
  invoiceNumber String?    @unique
  dueDate       DateTime?
  payments      Payment[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([customerId])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  email     String?
  phone     String
  address   String
  prices    SupplierPrice[]
  purchases Purchase[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model SupplierPrice {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model Purchase {
  id         String         @id @default(cuid())
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  supplierId String
  total      Float
  isPaid     Boolean        @default(false)
  status     PurchaseStatus @default(PENDING)
  receivedAt DateTime?
  items      PurchaseItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([supplierId])
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  price      Float
  received   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  name           String
  basePrice      Float
  currentStock   Int             @default(0)
  minStock       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplierPrices SupplierPrice[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  customPrices   CustomPrice[]
}

model SaleItem {
  id        String   @id @default(cuid())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
  discount  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
}

model Payment {
  id         String        @id @default(cuid())
  sale       Sale          @relation(fields: [saleId], references: [id])
  saleId     String
  amount     Float
  method     PaymentMethod
  reference  String? // For bank transfers and checks
  notes      String?
  recordedBy String // Email of user who recorded the payment
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([saleId])
}
