{
  "name": "goods-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:api": "jest --config jest.config.api.js \"__tests__/api/.*\\.test\\.ts\"",
    "test:components": "jest --config jest.config.components.js \"__tests__/components/.*\\.test\\.tsx\"",
    "test:integration": "jest --config jest.config.integration.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:test:push": "dotenv -e .env -- prisma db push --accept-data-loss",
    "db:test:setup": "dotenv -e .env -- prisma migrate reset --force --skip-seed",
    "test:setup": "ts-node scripts/setup-test-db.ts",
    "pretest": "npm run test:setup"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-mocks-http": "^1.16.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@types/pdfkit": "^0.13.8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.470.0",
    "next": "^14.2.23",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup/testSetup.ts"
    ]
  }
}
