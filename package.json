{
  "name": "goods-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "rm -rf .next && npx prisma generate && npm run build",
    "start": "next start",
    "postinstall": "chmod +x ./node_modules/.bin/prisma && chmod +x ./node_modules/.bin/next && npx prisma generate",
    "lint": "next lint",
    "test": "jest",
    "test:api": "jest --config jest.config.api.js \"__tests__/api/.*\\.test\\.ts\"",
    "test:components": "jest --config jest.config.components.js \"__tests__/components/.*\\.test\\.tsx\"",
    "test:integration": "jest --config jest.config.integration.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:test:push": "dotenv -e .env -- prisma db push --accept-data-loss",
    "db:test:setup": "dotenv -e .env -- prisma migrate reset --force --skip-seed",
    "test:setup": "ts-node scripts/setup-test-db.ts",
    "pretest": "npm run test:setup"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.57",
    "autoprefixer": "^10.4.17",
    "babel-jest": "^29.7.0",
    "dotenv-cli": "^7.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^14.1.0",
    "node-mocks-http": "^1.12.0",
    "postcss": "^8.4.35",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.10.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@types/pdfkit": "^0.13.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.330.0",
    "next-auth": "^4.24.5",
    "nodemailer": "^6.9.9",
    "pdfkit": "^0.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup/testSetup.ts"
    ]
  },
  "engines": {
    "node": "18.x"
  }
}
